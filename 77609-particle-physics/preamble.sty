\newcommand{\QCD}{\mathrm{QCD}}
\newcommand{\Lag}{\mathcal{L}}
\newcommand{\dphi}{\dot{\phi}}

%% ── Homework formatting (used by Homework/HW_*.tex subfiles) ────────────────
\usepackage{mdframed}
\newcounter{problem}
\newcommand{\problem}[1]{\stepcounter{problem}\subsection*{Question \theproblem: #1}}
\newenvironment{questionbox}{%
  \begin{mdframed}[linewidth=0.5pt, innertopmargin=3pt, innerbottommargin=3pt,
    innerleftmargin=3pt, innerrightmargin=3pt, backgroundcolor=gray!6]%
}{%
  \end{mdframed}\medskip}
\theoremstyle{definition}
\newtheorem{solution}{Solution}
\newenvironment{solutionbox}{%
  \begin{mdframed}[linewidth=0.5pt, innertopmargin=3pt, innerbottommargin=3pt,
    innerleftmargin=4pt, innerrightmargin=4pt, backgroundcolor=blue!4]%
  \textbf{Solution.}\par\smallskip
}{%
  \end{mdframed}\medskip}