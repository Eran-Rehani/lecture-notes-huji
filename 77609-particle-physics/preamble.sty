%% ── Homework formatting (used by Homework/HW_*.tex subfiles) ────────────────
\usepackage{mdframed}
\newcounter{problem}
\newcommand{\problem}[1]{\stepcounter{problem}\subsection*{Question \theproblem: #1}}
\newenvironment{questionbox}{%
  \begin{mdframed}[linewidth=0.5pt, innertopmargin=2pt, innerbottommargin=2pt,
    innerleftmargin=2pt, innerrightmargin=2pt, backgroundcolor=gray!6]%
}{%
  \end{mdframed}\medskip}
\theoremstyle{definition}
\newtheorem{solution}{Solution}
\newenvironment{solutionbox}{%
  \begin{mdframed}[linewidth=0.5pt, innertopmargin=2pt, innerbottommargin=2pt,
    innerleftmargin=2pt, innerrightmargin=2pt, backgroundcolor=white]%
  \textbf{Solution.}\par\smallskip
}{%
  \end{mdframed}\medskip}

%% ── Exam-compendium print switch ────────────────────────────────────────────
%% Set \examcompendiumtrue in the print master to hide "Further/Recommended
%% Reading" blocks and trim filler. Defaults to false so main.tex is unaffected.
\newif\ifexamcompendium
\examcompendiumfalse
%% furtherreading: wrap reading-list / further-reading blocks. Rendered normally,
%% but swallowed entirely when \examcompendiumtrue.
\usepackage{environ}
\NewEnviron{furtherreading}{\ifexamcompendium\else\BODY\fi}