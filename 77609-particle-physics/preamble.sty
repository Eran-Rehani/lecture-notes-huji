%% -- Page style --------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\setlength{\headheight}{14pt}
\let\oldpart\part
\renewcommand{\part}[1]{\oldpart{#1}\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\renewcommand{\subsectionmark}[1]{\markright{#1}}
\lhead{\small\nouppercase{\leftmark}}
\rhead{\small\nouppercase{\rightmark}}
\cfoot{\textbf{\thepage}}

%% ── Theorem environments (eye-candy tcolorbox) ───────────────────────────────
\usepackage{eye-candy}
\theoremstyle{remark}
\newtheorem{remark}{Remark}

%% -- General notation --------------------------------------------------------
\newcommand{\bvec}[1]{\mathbf{#1}}
\newcommand{\anticomm}[2]{\{#1,\, #2\}}
\newcommand{\expectval}[1]{\langle #1 \rangle}

%% -- QFT / particle physics specific ----------------------------------------
\newcommand{\lagr}{\mathcal{L}}
\newcommand{\hamilt}{\mathcal{H}}
\newcommand{\Mamp}{\mathcal{M}}
\newcommand{\partialmu}{\partial_{\mu}}
\newcommand{\fourvec}[1]{#1^{\mu}}
\newcommand{\lorentz}[1]{\Lambda^{\mu}_{\ \nu} #1}
\newcommand{\Dirac}[1]{\slashed{#1}}
\newcommand{\spinor}[1]{u_{#1}}
\newcommand{\propagator}[2]{\frac{i}{#1^2 - #2^2}}
\newcommand{\vertex}[1]{-ig_{#1}}
\newcommand{\dcross}{\frac{d\sigma}{d\Omega}}
\newcommand{\DecayRate}{\Gamma}

