 \newcommand{\br}{\mathbf{r}}
\newcommand{\bmu}{\boldsymbol{\mu}}

%% ── Homework subfile compatibility ──────────────────────────────────────────
\newcounter{problem}
\newcommand{\problem}[1]{%
  \stepcounter{problem}%
  \subsection*{\theproblem.\ #1}%
}
\newtheorem{question}{Question}[section]
\newtheorem*{solution}{Solution}
