%% ── Page style ───────────────────────────────────────────────────────────────
\setlength{\headheight}{13.6pt}
\addtolength{\topmargin}{-1.6pt}
\pagestyle{fancy}
\fancyhf{}
\AtBeginDocument{\renewcommand{\sectionmark}[1]{\markright{#1}}}
\lhead{\small \nouppercase{\leftmark}}
\rhead{\small \nouppercase{\rightmark}}
\cfoot{\thepage}

%% ── Theorem environments (eye-candy tcolorbox) ───────────────────────────────
\usepackage{eye-candy}
\theoremstyle{remark}
\newtheorem{remark}{Remark}

%% ── Vector notation ──────────────────────────────────────────────────────────
\newcommand{\bvec}[1]{\mathbf{#1}}
\newcommand{\uvec}[1]{\hat{\mathbf{#1}}}
\newcommand{\tens}[1]{\boldsymbol{#1}}

%% ── Differential operators 
\newcommand{\divg}{\nabla \cdot}
\newcommand{\lapl}{\nabla^2}
\newcommand{\ddt}{\frac{d}{dt}}

%% ── Electrodynamics specific ─────────────────────────────────────────────────
\newcommand{\Dvec}{\mathbf{D}}
\newcommand{\Hvec}{\mathbf{H}}
\newcommand{\Avec}{\mathbf{A}}
\newcommand{\Jvec}{\mathbf{J}}
\newcommand{\emtensor}{T^{\mu\nu}}
\newcommand{\fourvec}[1]{#1^{\mu}}
\newcommand{\contract}[1]{\eta_{\mu\nu}#1^{\mu}#1^{\nu}}
\newcommand{\Fmunu}{F^{\mu\nu}}
\newcommand{\partialmu}{\partial_{\mu}}
\newcommand{\Green}{G(\mathbf{r}, \mathbf{r}')}
\newcommand{\multipole}[2]{Q_{#1}^{#2}}    % multipole moment

