%% ── Page style ───────────────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\setlength{\headheight}{14pt}
% Left header = current \part; right header = current \section/\subsection
\let\oldpart\part
\renewcommand{\part}[1]{\oldpart{#1}\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\renewcommand{\subsectionmark}[1]{\markright{#1}}
\lhead{\small\nouppercase{\leftmark}}
\rhead{\small\nouppercase{\rightmark}}
\cfoot{\thepage}

%% ── Theorem environments (eye-candy tcolorbox) ───────────────────────────────
\usepackage{eye-candy}
\theoremstyle{remark}
\newtheorem{remark}{Remark}

%% ── General notation ─────────────────────────────────────────────────────────
\newcommand{\bvec}[1]{\mathbf{#1}}
\newcommand{\expectval}[1]{\langle #1 \rangle}

%% ── Nuclear physics specific ─────────────────────────────────────────────────
\newcommand{\nucleus}[2]{\ensuremath{{}^{#2}\mathrm{#1}}}   % \nucleus{Fe}{56} -> 56Fe
\newcommand{\BE}{B(E)}                          % binding energy
\newcommand{\Qval}{Q}                           % Q value
\newcommand{\xsec}{\sigma}                      % cross section
\newcommand{\formfac}{F(q)}                     % form factor
\newcommand{\isospin}{\mathbf{T}}               % isospin operator
\newcommand{\halflife}{t_{1/2}}                 % half-life
\newcommand{\activity}{\mathcal{A}}             % activity
\newcommand{\nucrad}{r_0}                       % nuclear radius parameter
\newcommand{\BW}{B_W}                           % Bethe-Weizsacker

