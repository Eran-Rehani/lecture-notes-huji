%% ── Page style ───────────────────────────────────────────────────────────────
\setlength{\headheight}{14pt}
\addtolength{\topmargin}{-2pt}
\pagestyle{fancy}
\fancyhf{}
% Left header = current \part; right header = current \section/\subsection
\let\oldpart\part
\renewcommand{\part}[1]{\oldpart{#1}\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\renewcommand{\subsectionmark}[1]{\markright{#1}}
\lhead{\small\nouppercase{\leftmark}}
\rhead{\small\bfseries\nouppercase{\rightmark}}
\cfoot{\bfseries\thepage}

%% ── Theorem environments (eye-candy tcolorbox) ───────────────────────────────
\usepackage{eye-candy}
\theoremstyle{remark}
\newtheorem{remark}{Remark}
\newenvironment{solution}{\begin{proof}[Solution]}{\end{proof}\par\vspace{0.5em}\noindent\makebox[\linewidth]{\color{myblue}\rule{1.5\linewidth}{1.5pt}}\vspace{1em}}
\newtheorem{problem}{Problem}[section]

%% ── Vector and tensor notation ───────────────────────────────────────────────
\newcommand{\bvec}[1]{\mathbf{#1}}
\newcommand{\uvec}[1]{\hat{\mathbf{#1}}}
\newcommand{\tens}[1]{\boldsymbol{#1}}

%% ── Differential operators ───────────────────────────────────────────────────
\newcommand{\divg}{\nabla \cdot}
\newcommand{\lapl}{\nabla^2}
\newcommand{\ddt}{\frac{d}{dt}}
\newcommand{\DDt}{\frac{D}{Dt}}

%% ── Continuum mechanics specific ─────────────────────────────────────────────
\newcommand{\stress}{\tens{\sigma}}           % stress tensor
\newcommand{\strain}{\tens{\varepsilon}}      % strain tensor
\newcommand{\defgrad}{\mathbf{F}}             % deformation gradient
\newcommand{\vel}{\mathbf{v}}                 % velocity field
\newcommand{\body}{\mathbf{f}}                % body force
\newcommand{\reynolds}{\mathrm{Re}}           % Reynolds number
\newcommand{\material}[1]{\frac{D#1}{Dt}}    % material derivative
\newcommand{\refcoord}{\mathbf{X}}            % Lagrangian coord
\newcommand{\curcoord}{\mathbf{x}}            % Eulerian coord

